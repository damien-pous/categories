-native-compiler no
-arg -w -arg -undo-batch-mode
-arg -w -arg -notation-overridden          # temporary, for mathcomp
-arg -w -arg -uniform-inheritance
-arg -w -arg +HB.no-new-instance

-R theories/ Categories
theories/prelim.v                          # preliminaries, reserved notations
theories/cat.v                             # quivers, categories, basic infrastructure
theories/arewrite.v			   # rewriting/reflexivity modulo associativity
theories/morphisms.v                       # hierarchy of morphisms
theories/airewrite.v			   # rewriting/reflexivity modulo associativity and inverses
theories/arity.v                           # lists of objects
theories/cast.v                            # casting operations
theories/functor.v                         # functors
theories/adjunction.v                      # adjunctions
theories/objects.v                         # hierarchy of objects
theories/algebra.v                         # (co)algebras
theories/setoid.v                          # the category of setoids
theories/span.v                            # spans
theories/product.v                         # products
theories/cat_cat.v                         # Cat: Cat (needs universe polymorphism, hence type:type for now)
theories/monoidal_def.v                    # definition of monoidal categories
theories/endo.v                            # the (strict) monoidal category of endofuntcors
theories/monoidal_maclane.v                # MacLane theorem for monoidal categories
theories/monoidal_gmaclane.v               # extended MacLane theorem + inferrence of MacLane isomorphisms
theories/monoidal_tactic.v                 # decision procedure for monoidal cats
theories/monoidal.v                        # user-end module for monoidal cats
theories/monoidal_examples.v               # example: composing monoids

-R tests/ CategoriesTests
tests/coercions.v			   # tests for the coercion setup
tests/arewrite_tests.v			   # tests for the arewrite/areflexivity tactics
tests/airewrite_tests.v	 	   	   # tests for the airewrite/aireflexivity tactics
tests/hb_univ.v			   	   # waiting for HB to support universe polymorphism
