% Elpi code for aireflexivity: the reflexivity tactic modulo G
% initial author: Kazuhiko Sakaguchi, late 2025 - early 2026,
%   in the context of the graph-rewriting library we developped with Samuel Arsac
% adapted by Damien Pous to deal with the new way categorical structures are defined

solve (goal _ _ Type _ _ as G) [] :- @ltacfail! 0 => std.do! [
  std.assert-ok! (coq.unify-eq Type {{ @eqv lp:Setoid lp:LHS lp:RHS }})
    "The goal is not a setoid equivalence",
  std.assert-ok! (coq.unify-eq {{Setoid.sort lp:Setoid}} {{ @hom lp:BareQuiver lp:Src lp:Tgt }})
    "The setoid is not a hom-set",
  std.assert-ok! (coq.unify-eq BareQuiver {{ (barequiver_of_cat lp:Cat) }})
    "The quiver is not a cat",
  BarePreCat = {{ bareprecat_of_cat lp:Cat }},
  PreCat = {{ precat_of_cat lp:Cat }},
  quote BarePreCat Src Tgt LHS LHSQ LHS',
  quote BarePreCat Src Tgt RHS RHSQ RHS',
  path.match PreCat Src Tgt LHS' RHS' CE,
  (refine {{ @aireflexivity_correct lp:Cat lp:Src lp:Tgt
               lp:LHSQ lp:RHSQ lp:CE erefl erefl }} G []% ;
   % coq.ltac.fail 0 "Not a valid equivalence"
   )
].
